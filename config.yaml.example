# AgentCommon backend configuration template.
# Copy this file to config.yaml and adjust as needed.
# Secrets (the LLM API key) must be provided via the ANTHROPIC_API_KEY
# environment variable, never committed to the repository.
# Environment variables take precedence over this file.

# ---- Model ----
model: claude-opus-4-8
effort: high                 # low / medium / high - controls cost vs quality
max_tokens: 16000

# ---- Agent engine safety limits ----
tool_breaker_limit: 3        # circuit-break a tool after N consecutive failures
max_iterations: 30           # max agent-loop iterations per turn
approval_timeout_s: 120      # auto-deny pending approvals after this timeout
session_idle_timeout_s: 600  # recycle idle session loop tasks after 10 minutes

# ---- Task planner ----
# For medium/complex tasks the planner first emits a task_options event with
# candidate execution plans; on timeout it auto-selects the recommended one.
# false -> messages go straight into the agent loop, planner disabled.
planner_enabled: true
planner_max_options: 4       # max options per plan (2~4)
planner_timeout_s: 120       # user choice timeout (seconds)
# Long-task progress push: once a task is flagged long-running (past
# long_running_after_s), task_progress events are emitted every interval.
progress_interval_s: 60
long_running_after_s: 90

# ---- Storage ----
# SQLite for development; switch to PostgreSQL in production
# (e.g. postgresql+asyncpg://user:pass@host/db)
database_url: sqlite+aiosqlite:///./data/agent.db

# ---- Workspaces ----
# workspace_root is only the initial seed: when the workspace_dirs table is
# empty it becomes the first workspace directory (source=user). Directories
# are managed at runtime via the /api/workspaces endpoints or agent tools
# (add_workspace_dir / remove_workspace_dir); changes take effect immediately.
# Paths may be absolute (e.g. D:\data) or relative to the backend CWD.
workspace_root: ../workspace
agent_manage_dirs: true      # false -> agent may not add/remove workspace dirs

# ---- MCP integration ----
# Each entry: name + (command/args -> stdio subprocess) or (url -> streamable
# http). Tools register under the mcp__<server>__<tool> namespace prefix.
# Startup failure degrades gracefully: a single broken server is skipped with
# a warning and the rest keep working.
# The bundled demo server (demo_mcp_server.py, tools current_time / echo_text)
# works out of the box - ask the model "what time is it" to see the full
# MCP pipeline in action.
mcp_servers:
  - name: demo
    command: "python"            # bare python resolves to the backend venv
    args: ["demo_mcp_server.py"] # or use an absolute interpreter path
  # - name: search
  #   url: "http://127.0.0.1:8080/mcp"
  #   enabled: false              # per-server switch

# ---- Self-extending agent ----
# Meta tools: discover_tools / install_mcp_server / uninstall_mcp_server /
# run_python. install/uninstall/run_python are dangerous=true and go through
# the approval gate before executing (guards against prompt-injection
# attempts to install malicious tools or run arbitrary code).
enable_tool_discovery: true  # false -> all four meta tools return is_error
tool_catalog_path: tool_catalog.yaml  # curated catalog searched by discover_tools
run_python_max_timeout_s: 120  # hard cap for run_python; larger values are clamped
